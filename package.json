{
  "name": "baset-video-downloader",
  "productName": "Baset Video Downloader",
  "version": "1.0.0",
  "description": "BVD - Windows desktop media download manager",
  "author": "Abdulbaset R. Sayed",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "scan:ui": "node scripts/scan-ui-rules.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run scan:ui",
    "smoke": "bash scripts/smoke.sh",
    "licenses": "node scripts/license-inventory.mjs",
    "prepare:tools:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-windows-tools.ps1",
    "dist:win": "npm run check && npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:win:all": "npm run prepare:tools:win && npm run dist:win",
    "verify:tools:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-tools.ps1"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "electron-store": "^12.0.0",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "build": {
    "appId": "com.abdulbasetrs.bvd",
    "productName": "Baset Video Downloader",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sounds",
        "to": "sounds"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      },
      {
        "from": "resources/tools/win32-x64",
        "to": "tools/win32-x64"
      },
      {
        "from": "build/icons/bvd-app-icon.png",
        "to": "bvd-app-icon.png"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "icon": "build/icons/bvd-app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BVD-${target}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Baset Video Downloader",
      "deleteAppDataOnUninstall": false,
      "artifactName": "BVD-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BVD-Portable-${version}-${arch}.${ext}"
    },
    "compression": "maximum"
  },
  "license": "MIT"
}
